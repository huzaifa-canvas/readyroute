# Port the socket server listens on. Behind nginx in production so clients
# connect over wss:// -- iOS refuses plaintext WebSocket connections.
PORT=3001

# Where to reach Laravel for token verification and presence reporting.
LARAVEL_URL=http://127.0.0.1:8000

# Must match SOCKET_SECRET in the Laravel .env. Both directions use it.
SOCKET_SECRET=change-me

# Comma separated origins allowed to connect. Mobile apps send no origin, so
# they are unaffected; this is for the dispatcher web panel.
CORS_ORIGINS=http://readyroute.test,http://localhost:8000

LOG_LEVEL=info
